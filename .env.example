# Server-only keys. Never expose these with NEXT_PUBLIC_*.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_WARM=
ELEVENLABS_VOICE_CALM=
ELEVENLABS_VOICE_ENERGETIC=

N8N_HELP_WEBHOOK_URL=

# Client-visible flags. No secrets here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_USE_MOCKS=1
NEXT_PUBLIC_ENABLE_LANDING_3D=1
NEXT_PUBLIC_ENABLE_GIST=1
NEXT_PUBLIC_ENABLE_STILL_FRAME=0
NEXT_PUBLIC_ENABLE_N8N=0
NEXT_PUBLIC_ENABLE_SCRIBE=0
