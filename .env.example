# ElevenLabs — server only, never NEXT_PUBLIC
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_WARM=
ELEVENLABS_VOICE_CALM=
ELEVENLABS_VOICE_ENERGETIC=

# Gemini (gist, later)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional integrations, off by default
N8N_HELP_WEBHOOK_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flags
NEXT_PUBLIC_USE_MOCKS=0
NEXT_PUBLIC_ENABLE_LANDING_3D=0
NEXT_PUBLIC_ENABLE_TEACH=0
NEXT_PUBLIC_ENABLE_GIST=0
